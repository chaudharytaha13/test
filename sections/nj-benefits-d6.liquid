{%- style -%}
  .nj-benefits-d6 {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    background-image: {% if section.settings.background_image %}url({{ section.settings.background_image | image_url: width: 1920 }}){% else %}none{% endif %};
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
  }

  .nj-benefits-d6 .container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nj-benefits-d6 .section-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .nj-benefits-d6 .section-title {
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.title_color }};
    font-weight: {{ section.settings.title_font_weight }};
    margin: 0 0 {{ section.settings.title_margin_bottom }}px;
    line-height: 1.2;
  }

  .nj-benefits-d6 .section-subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
  }

  .nj-benefits-layout {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.layout_height }}px;
    margin: {{ section.settings.layout_margin_top }}px 0 {{ section.settings.layout_margin_bottom }}px;
  }

  .center-product {
    position: relative;
    z-index: 5;
    width: {{ section.settings.center_image_width }}px;
    height: {{ section.settings.center_image_height }}px;
    border-radius: {{ section.settings.center_image_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ section.settings.center_image_shadow }};
    background-color: {{ section.settings.center_image_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-product img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .benefits-grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr {{ section.settings.center_image_width }}px 1fr;
    grid-template-rows: 1fr {{ section.settings.center_image_height }}px 1fr;
    gap: {{ section.settings.grid_gap }}px;
    align-items: center;
    justify-items: center;
  }

  .benefit-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-shadow: {{ section.settings.card_shadow }};
    text-align: center;
    max-width: {{ section.settings.card_max_width }}px;
    width: 100%;
    position: relative;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .benefit-card:hover {
    transform: translateY({{ section.settings.card_hover_translate }}px);
    box-shadow: {{ section.settings.card_hover_shadow }};
  }

  .benefit-card.top-left {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    align-self: end;
  }

  .benefit-card.top-right {
    grid-column: 3;
    grid-row: 1;
    justify-self: start;
    align-self: end;
  }

  .benefit-card.bottom-left {
    grid-column: 1;
    grid-row: 3;
    justify-self: end;
    align-self: start;
  }

  .benefit-card.bottom-right {
    grid-column: 3;
    grid-row: 3;
    justify-self: start;
    align-self: start;
  }

  .benefit-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin: 0 auto {{ section.settings.icon_margin_bottom }}px;
    background-color: {{ section.settings.icon_background }};
    border-radius: {{ section.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.icon_font_size }}px;
    color: {{ section.settings.icon_color }};
  }

  .benefit-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .benefit-title {
    font-size: {{ section.settings.benefit_title_size }}px;
    color: {{ section.settings.benefit_title_color }};
    font-weight: {{ section.settings.benefit_title_weight }};
    margin: 0 0 {{ section.settings.benefit_title_margin }}px;
    line-height: 1.3;
  }

  .benefit-description {
    font-size: {{ section.settings.benefit_desc_size }}px;
    color: {{ section.settings.benefit_desc_color }};
    line-height: 1.5;
    margin: 0;
  }

  .arrow-connector {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    width: {{ section.settings.arrow_width }}px;
    height: {{ section.settings.arrow_height }}px;
  }

  .arrow-connector img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .arrow-top-left {
    top: 25%;
    left: 32%;
    transform: rotate({{ section.settings.arrow_rotation_tl }}deg);
  }

  .arrow-top-right {
    top: 25%;
    right: 32%;
    transform: rotate({{ section.settings.arrow_rotation_tr }}deg);
  }

  .arrow-bottom-left {
    bottom: 25%;
    left: 32%;
    transform: rotate({{ section.settings.arrow_rotation_bl }}deg);
  }

  .arrow-bottom-right {
    bottom: 25%;
    right: 32%;
    transform: rotate({{ section.settings.arrow_rotation_br }}deg);
  }

  .section-cta {
    text-align: center;
    margin-top: {{ section.settings.cta_margin_top }}px;
  }

  .cta-button {
    display: inline-block;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_tb }}px {{ section.settings.button_padding_lr }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    transition: all 0.3s ease;
    box-shadow: {{ section.settings.button_shadow }};
  }

  .cta-button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
    transform: translateY({{ section.settings.button_hover_translate }}px);
    box-shadow: {{ section.settings.button_hover_shadow }};
  }

  @media (max-width: 768px) {
    .nj-benefits-d6 {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    .benefits-layout {
      min-height: auto;
      flex-direction: column;
      gap: 30px;
    }

    .benefits-grid {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .center-product {
      order: 0;
      width: {{ section.settings.mobile_center_width }}px;
      height: {{ section.settings.mobile_center_height }}px;
    }

    .benefit-card {
      order: 1;
      max-width: 100%;
    }

    .arrow-connector {
      display: none;
    }
  }
{%- endstyle -%}

<section class="nj-benefits-d6" id="nj-benefits-d6-{{ section.id }}">
  <div class="container">
    {% if section.settings.show_header %}
      <div class="section-header">
        {% if section.settings.section_title != blank %}
          <h2 class="section-title">{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_subtitle != blank %}
          <p class="section-subtitle">{{ section.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="benefits-layout">
      <div class="center-product">
        {% if section.settings.center_image != blank %}
          <img src="{{ section.settings.center_image | image_url: width: section.settings.center_image_width }}" 
               alt="{{ section.settings.center_image_alt | default: section.settings.section_title }}">
        {% else %}
          <div style="background: linear-gradient(45deg, #f0f0f0, #e0e0e0); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #666;">
            <span>Product Image</span>
          </div>
        {% endif %}
      </div>

      <div class="benefits-grid">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="benefit-card {{ block.settings.position }}" {{ block.shopify_attributes }}>
              {% if block.settings.icon_image != blank or block.settings.icon_text != blank %}
                <div class="benefit-icon">
                  {% if block.settings.icon_image != blank %}
                    <img src="{{ block.settings.icon_image | image_url: width: section.settings.icon_size }}" 
                         alt="{{ block.settings.benefit_title }}">
                  {% elsif block.settings.icon_text != blank %}
                    {{ block.settings.icon_text }}
                  {% endif %}
                </div>
              {% endif %}
              
              {% if block.settings.benefit_title != blank %}
                <h3 class="benefit-title">{{ block.settings.benefit_title }}</h3>
              {% endif %}
              
              {% if block.settings.benefit_description != blank %}
                <p class="benefit-description">{{ block.settings.benefit_description }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        {% if section.settings.arrow_image_tl != blank %}
          <div class="arrow-connector arrow-top-left">
            <img src="{{ section.settings.arrow_image_tl | image_url: width: section.settings.arrow_width }}" alt="Arrow">
          </div>
        {% endif %}
        
        {% if section.settings.arrow_image_tr != blank %}
          <div class="arrow-connector arrow-top-right">
            <img src="{{ section.settings.arrow_image_tr | image_url: width: section.settings.arrow_width }}" alt="Arrow">
          </div>
        {% endif %}
        
        {% if section.settings.arrow_image_bl != blank %}
          <div class="arrow-connector arrow-bottom-left">
            <img src="{{ section.settings.arrow_image_bl | image_url: width: section.settings.arrow_width }}" alt="Arrow">
          </div>
        {% endif %}
        
        {% if section.settings.arrow_image_br != blank %}
          <div class="arrow-connector arrow-bottom-right">
            <img src="{{ section.settings.arrow_image_br | image_url: width: section.settings.arrow_width }}" alt="Arrow">
          </div>
        {% endif %}
      {% endif %}
    </div>

    {% if section.settings.show_cta and section.settings.cta_text != blank %}
      <div class="section-cta">
        <a href="{{ section.settings.cta_link | default: '#' }}" class="cta-button">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

